@page
@model movies_collection.Pages.Movies.EditModel

@{
    ViewData["Title"] = "Edit - " + Model.Movie.Title;
}

<h1>Edit movie named @Model.Movie.Title</h1>

<hr />
<p class="fst-italic">(*) Required fields</p>
<div class="row d-flex align-items-center">
    <div class="col-lg-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Movie.MovieId" />
            <input type="hidden" asp-for="Movie.MoviePosterUrl" />
            <div class="form-group">
                <span class="fw-bold text-danger"><label asp-for="Movie.Title" class="control-label"></label>*</span>
                <input asp-for="Movie.Title" class="form-control" autofocus />
                <span asp-validation-for="Movie.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="fw-bold text-primary" asp-for="Movie.ReleaseYear" class="control-label"></label>
                <input asp-for="Movie.ReleaseYear" class="form-control" />
                <span asp-validation-for="Movie.ReleaseYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="fw-bold text-primary"><label asp-for="Movie.Duration" class="control-label"></label> (minutes)</span>
                <input asp-for="Movie.Duration" class="form-control" />
                <span asp-validation-for="Movie.Duration" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="fw-bold text-primary" asp-for="Movie.LastWatchedYear" class="control-label"></label>
                <input asp-for="Movie.LastWatchedYear" class="form-control" />
                <span asp-validation-for="Movie.LastWatchedYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="fw-bold text-primary"><label asp-for="Movie.Genre" class="control-label"></label> (Press Ctrl key to select multiple options)</span>
                <select asp-for="SelectedGenres" asp-items="ViewBag.Genres" class="form-select" multiple></select>
                <span asp-validation-for="SelectedGenres" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="fw-bold text-primary"><label asp-for="Movie.Rating" class="control-label"></label> (1~100)</span>
                <input asp-for="Movie.Rating" class="form-control" />
                <span asp-validation-for="Movie.Rating" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="fw-bold text-primary" asp-for="Movie.Description" class="control-label"></label>
                <textarea asp-for="Movie.Description" class="form-control"></textarea>
                <span asp-validation-for="Movie.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="fw-bold text-primary" asp-for="Movie.MoviePosterUrl" class="control-label"></label>
                <input type="file" asp-for="Upload" class="form-control" accept="image/*" />
                <span asp-validation-for="Upload" class="text-danger"></span>
            </div>
            <div class="form-group my-2">
                <input type="submit" value="Save" class="border border-1 border-primary rounded-3 px-2 me-2 bg-primary text-white text-decoration-none fw-bold fs-5" />
            </div>
        </form>
    </div>
    <div class="col-lg-8">
        <p class="text-primary fw-bold my-2 fst-italic text-center">Current Poster</p>
        <div class="text-center">
            <img 
                @if (Model.Movie.MoviePosterUrl == null || Model.Movie.MoviePosterUrl == "")
                {
                    <text>src="@Url.Content("~/img/popcorn.png")"</text>
                }
                else
                {
                    <text>src="@Url.Content($"~/movieimg/{Model.Movie.MoviePosterUrl}")"</text>
                }
                alt="@Model.Movie.Title Poster"
                class="img-thumbnail"
                style="max-width:100%"
            />
        </div>
        <div class="form-group my-2 d-flex justify-content-center">
            <a asp-page="./Details" class="border border-1 border-warning rounded-3 px-2 me-2 bg-warning text-white text-decoration-none fw-bold fs-5" asp-route-id="@Model.Movie.MovieId">Back to Details</a> ---
            <a asp-page="./Index" class="border border-1 border-secondary rounded-3 px-2 ms-2 bg-secondary text-white text-decoration-none fw-bold fs-5">Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
